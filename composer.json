{
  "name": "birkof/netopia-mobilpay-bundle",
  "description": "Seamless integration of Netopia MobilPay Payment Gateway into your Symfony application",
  "type": "symfony-bundle",
  "minimum-stability": "stable",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "birkof\\NetopiaMobilPay\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "birkof\\NetopiaMobilPay\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "birkof/netopia-mobilpay": "^4.0",
    "symfony/monolog-bundle": "^3.7",
    "symfony/routing": "^4.4 || ^5.0 || ^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
